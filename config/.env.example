# Copy this file to the project root as `.env` and fill in the values.
# NEVER commit .env. The tool never prints these values.
#
# How to find them (Chrome/Edge):
#   1. Log in at https://fantasy.espn.com and open your league.
#   2. Press F12 -> Application tab -> Storage -> Cookies -> https://fantasy.espn.com
#   3. Copy the value of `espn_s2` (long string) and `SWID` (looks like {XXXXXXXX-XXXX-...}, keep the braces).
# Safari: Develop menu -> Show Web Inspector -> Storage -> Cookies.
ESPN_S2=
ESPN_SWID=
